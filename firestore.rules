rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user is an admin
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || 
         request.auth.token.email.matches('.*admin.*') ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Helper function to check ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow write: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true; // Publicly readable for all customers
      allow create, update, delete: if isAdmin(); // Only admins can modify prices/inventory
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Mystery Scoops Collection
    match /mysteryScoops/{scoopId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Gift Hampers Collection
    match /giftHampers/{hamperId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      // Customers can read only their own orders; admins can read all orders
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isAdmin());
      // Orders are created through secure cloud functions or server API routes
      allow create: if isAuthenticated();
      // Only admins or secure backend can update order status (prevent customers from modifying status)
      allow update, delete: if isAdmin();
    }

    // Carts Collection
    match /carts/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // Wishlists Collection
    match /wishlists/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // Coupons Collection
    match /coupons/{couponId} {
      allow read: if true; // Customers can check coupons
      allow write: if isAdmin(); // Only admin can create or change discounts
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true; // Public reviews
      allow create: if isAuthenticated(); // Customers can post reviews
      allow update, delete: if isAdmin(); // Only admins can approve or delete
    }

    // Banners & Promos
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Store Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
